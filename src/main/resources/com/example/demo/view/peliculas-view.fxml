<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="760.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.viewController.PeliculasViewController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestion de peliculas" />
      <TableView fx:id="tblPeliculas" prefHeight="260.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Codigo" />
            <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
            <TableColumn fx:id="colGenero" prefWidth="130.0" text="Genero" />
            <TableColumn fx:id="colDuracion" prefWidth="70.0" text="Duracion" />
            <TableColumn fx:id="colClasificacion" prefWidth="110.0" text="Clasificacion" />
            <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
         </columns>
      </TableView>
      <GridPane hgap="10.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints minWidth="100.0" />
            <ColumnConstraints minWidth="200.0" prefWidth="250.0" />
            <ColumnConstraints minWidth="100.0" />
            <ColumnConstraints minWidth="200.0" prefWidth="250.0" />
         </columnConstraints>
         <children>
            <Label text="Codigo" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Nombre" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label text="Genero" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbGenero" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Duracion (min)" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="txtDuracion" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <Label text="Clasificacion" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbClasificacion" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#registrarPelicula" text="Registrar" />
            <Button mnemonicParsing="false" onAction="#modificarPelicula" text="Modificar" />
            <Button mnemonicParsing="false" onAction="#deshabilitarPelicula" text="Deshabilitar" />
            <Button mnemonicParsing="false" onAction="#eliminarPelicula" text="Eliminar" />
            <Button mnemonicParsing="false" onAction="#deseleccionar" text="Deseleccionar" />
         </children>
      </HBox>
   </children>
</VBox>
