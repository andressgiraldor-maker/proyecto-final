<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="540.0" prefWidth="560.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.viewController.AsientosViewController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblSala" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Asientos" />
      <TableView fx:id="tblAsientos" prefHeight="340.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Codigo" />
            <TableColumn fx:id="colFila" prefWidth="120.0" text="Fila" />
            <TableColumn fx:id="colNumero" prefWidth="120.0" text="Numero" />
            <TableColumn fx:id="colEstado" prefWidth="160.0" text="Estado" />
         </columns>
      </TableView>
      <GridPane hgap="10.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints minWidth="60.0" />
            <ColumnConstraints minWidth="150.0" prefWidth="180.0" />
            <ColumnConstraints minWidth="60.0" />
            <ColumnConstraints minWidth="150.0" prefWidth="180.0" />
         </columnConstraints>
         <children>
            <Label text="Fila" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtFila" promptText="Ej: A" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Numero" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNumero" promptText="Ej: 1" GridPane.columnIndex="3" GridPane.rowIndex="0" />
         </children>
      </GridPane>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#registrarAsiento" text="Registrar" />
            <Button mnemonicParsing="false" onAction="#modificarAsiento" text="Modificar" />
            <Button mnemonicParsing="false" onAction="#eliminarAsiento" text="Eliminar" />
            <Button mnemonicParsing="false" onAction="#deseleccionar" text="Deseleccionar" />
         </children>
      </HBox>
   </children>
</VBox>
