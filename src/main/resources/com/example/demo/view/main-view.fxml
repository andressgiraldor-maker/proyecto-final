<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="640.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.viewController.MainViewController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblNombreCine" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Cine" />
      <HBox spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#abrirGestionPeliculas" text="Gestionar peliculas" />
            <Button mnemonicParsing="false" onAction="#abrirGestionSalas" text="Gestionar salas" />
            <Button mnemonicParsing="false" onAction="#abrirGestionPersonas" text="Gestionar personas" />
         </children>
      </HBox>
      <Label text="Peliculas disponibles" />
      <ListView fx:id="lstPeliculas" prefHeight="150.0" />
      <Label text="Funciones programadas" />
      <ListView fx:id="lstFunciones" prefHeight="200.0" />
   </children>
</VBox>
